generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id        String   @id @default(uuid())
  username  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  GameSession[]
  saveSlots SaveSlot[]
}

model GameSession {
  id        String   @id @default(uuid())
  playerId  String
  mode      String   @default("test")
  label     String   @default("Local Test Session")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player    Player   @relation(fields: [playerId], references: [id])
  saveSlots SaveSlot[]
}

model SaveSlot {
  id        String   @id @default(uuid())
  playerId  String
  sessionId String?
  slotIndex Int      @default(0)

  currentChapter String @default("chapter-01")
  currentRoom    String @default("first-room")
  checkpointId   String @default("intro")

  positionX Float    @default(0)
  positionY Float    @default(0)

  inventoryItems   Json @default("[]")
  collectedClues   Json @default("[]")
  journalEntries   Json @default("[]")
  puzzleFlags      Json @default("{}")
  settingsSnapshot Json @default("{}")

  deathCount Int @default(0)
  retryCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player  Player       @relation(fields: [playerId], references: [id])
  session GameSession? @relation(fields: [sessionId], references: [id])

  @@unique([playerId, slotIndex])
}
